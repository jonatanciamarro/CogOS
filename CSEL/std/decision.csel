ENTITY Decision {

    TYPE:
        AbstractConcept

    IDENTITY:
        cse://concept/std.decision

    CONSTRAINTS:
        requires cse://concept/std.knowledge
        requires cse://concept/std.invariant

    TRANSFORMATION:
        Knowledge + Context + Constraints => Decision

    CONFIDENCE:
        1.00

    LINEAGE:
        derived_from cse://invariant/traceability
}
