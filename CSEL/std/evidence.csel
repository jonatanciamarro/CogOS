ENTITY Evidence {

    TYPE:
        AbstractConcept

    IDENTITY:
        cse://concept/std.evidence

    CONSTRAINTS:
        requires cse://concept/std.observation
        requires cse://concept/std.experiment

    TRANSFORMATION:
        Observation + Experiment => Evidence

    CONFIDENCE:
        1.00

    LINEAGE:
        derived_from cse://invariant/identity
}
